[
  {
    "id": "rule-direct-email",
    "name": "Direct Identifier: Email Address",
    "data_class": "DIRECT_IDENTIFIER",
    "column_pattern": "(?:^|_)(?:email|e_mail|email_addr|mail)(?:$|_)",
    "value_pattern": "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$",
    "column_weight": 0.65,
    "value_weight": 0.7,
    "min_value_match_ratio": 0.4,
    "enabled": true,
    "notes": "Matches email column names and RFC-like email value patterns."
  },
  {
    "id": "rule-direct-name-phone-handle",
    "name": "Direct Identifier: Name, Phone & Handle",
    "data_class": "DIRECT_IDENTIFIER",
    "column_pattern": "(?:full_name|employee_name|first_name|last_name|username|phone|mobile|reporter_handle|handle)",
    "value_pattern": "(?:^@[A-Za-z0-9_]{3,}$|^\\+\\d[\\d\\-\\s]{7,15}\\d$|^\\(\\d{3}\\)\\s?\\d{3}-\\d{4}$)",
    "column_weight": 0.72,
    "value_weight": 0.55,
    "min_value_match_ratio": 0.35,
    "enabled": true,
    "notes": "Detects personal names, phone numbers, and social/support handles."
  },
  {
    "id": "rule-national-id",
    "name": "National ID: Passport, SSN, Aadhaar & Tax PAN",
    "data_class": "NATIONAL_ID",
    "column_pattern": "(?:passport|ssn|aadhaar|national_tax_id|national_id|tax_pan|pan_ref|govt_id)",
    "value_pattern": "(?:^\\d{3}-\\d{2}-\\d{4}$|^\\d{4}\\s?\\d{4}\\s?\\d{4}$|^[A-Z]{5}\\d{4}[A-Z]$|^[A-Z]\\d{7}$)",
    "column_weight": 0.7,
    "value_weight": 0.75,
    "min_value_match_ratio": 0.35,
    "enabled": true,
    "notes": "Identifies synthetic SSN, Aadhaar, Indian PAN, and passport number formats."
  },
  {
    "id": "rule-financial-core",
    "name": "Financial Info: IBAN, Bank Account, Card, Salary & Billing",
    "data_class": "FINANCIAL_INFO",
    "column_pattern": "(?:iban|ifsc|routing|card|salary|payout|dispute_amt|billing|account)",
    "value_pattern": "(?:^[A-Z]{2}\\d{2}[A-Z0-9]{10,24}$|^[A-Z]{4}0[A-Z0-9]{6}$|^\\d{4}-[Xx*]{4}-[Xx*]{4}-\\d{4}$|^\\$?\\d{2,6}\\.\\d{2}$|^\\d{10,18}$)",
    "column_weight": 0.65,
    "value_weight": 0.45,
    "min_value_match_ratio": 0.4,
    "enabled": true,
    "notes": "Broad 'account' keyword intentionally demonstrates a tunable false positive on account_tier."
  },
  {
    "id": "rule-contact-location",
    "name": "Contact & Location: Street, City, Postal & GPS",
    "data_class": "CONTACT_LOCATION",
    "column_pattern": "(?:address|street|city|postal|zip|gps|coord|location)",
    "value_pattern": "(?:^-?\\d{1,2}\\.\\d{3,},\\s*-?\\d{1,3}\\.\\d{3,}$|^\\d{5,6}$)",
    "column_weight": 0.7,
    "value_weight": 0.4,
    "min_value_match_ratio": 0.4,
    "enabled": true,
    "notes": "Note: excludes 'pin' by default to show a recall gap on residential_pin until tuned."
  },
  {
    "id": "rule-sensitive-attribute",
    "name": "Sensitive Attribute: Health, Biometric & Religious Data",
    "data_class": "SENSITIVE_ATTRIBUTE",
    "column_pattern": "(?:medical|health|symptom|biometric|religious|ethnicity|diagnosis|accommodation)",
    "value_pattern": "(?:^bio_vec_[a-f0-9]+$|allergic|insulin|lumbar|halal|kosher|jain|migraine)",
    "column_weight": 0.72,
    "value_weight": 0.6,
    "min_value_match_ratio": 0.25,
    "enabled": true,
    "notes": "Flags special-category attributes including medical accommodations, health notes, biometrics, and religion."
  }
]